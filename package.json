{
  "name": "dj-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "desktop/build/main.mjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "start": "tsc -b && vite build && vite preview --port 4173 --open",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "license": "node scripts/license.mjs",
    "e2e": "playwright test",
    "helper": "node helper/setcraft-helper.mjs",
    "setcraft": "tsc -b && vite build && node helper/setcraft-helper.mjs",
    "desktop:build": "tsc -b && vite build && vite build --config desktop/vite.config.ts",
    "desktop": "npm run desktop:build && electron .",
    "desktop:dist": "npm run desktop:build && electron-builder --mac"
  },
  "dependencies": {
    "music-metadata": "12.3.4"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@playwright/test": "1.56.1",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "45.2.2",
    "electron-builder": "26.18.0",
    "fflate": "0.8.3",
    "idb-keyval": "^6.3.0",
    "jsdom": "^30.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
